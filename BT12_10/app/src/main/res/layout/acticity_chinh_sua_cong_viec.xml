<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".ChinhSuaCongViecActivity">

    <TextView
        android:id="@+id/tvTieuDeSua"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CHỈNH SỬA CÔNG VIỆC"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ô sửa tên công việc -->
    <EditText
        android:id="@+id/edtSuaTenCV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Tên công việc"
        android:inputType="textCapSentences"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@id/tvTieuDeSua"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ô sửa mô tả công việc -->
    <EditText
        android:id="@+id/edtSuaMoTaCV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Mô tả công việc"
        android:inputType="textMultiLine"
        android:lines="4"
        android:gravity="top|start"
        app:layout_constraintTop_toBottomOf="@id/edtSuaTenCV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvNhanUuTien"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mức độ ưu tiên:"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/edtSuaMoTaCV"
        app:layout_constraintStart_toStartOf="parent" />

    <RadioGroup
        android:id="@+id/rgMucDoUuTien"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvNhanUuTien"
        app:layout_constraintStart_toStartOf="parent">

        <RadioButton
            android:id="@+id/rbThap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thấp" />

        <RadioButton
            android:id="@+id/rbTrungBinh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Trung bình" />

        <RadioButton
            android:id="@+id/rbCao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cao" />
    </RadioGroup>

    <!-- Nút Lưu -->
    <Button
        android:id="@+id/btnLuuCV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Lưu thay đổi"
        app:layout_constraintTop_toBottomOf="@id/edtSuaMoTaCV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>