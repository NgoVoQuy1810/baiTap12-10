<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".MainActivity">

    <!-- Thông tin sinh viên -->
    <TextView
        android:id="@+id/tvThongTinSV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Họ tên: Ngô Võ Quý \n Mssv: 2415053122236 \n Lớp HP: 126TLTTD01"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tiêu đề chức năng -->
    <TextView
        android:id="@+id/tvTieuDe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="QUẢN LÝ CÔNG VIỆC"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvThongTinSV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nhập tên công việc -->
    <EditText
        android:id="@+id/edtTenCV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="16dp"
        android:hint="Nhập tên công việc"
        android:inputType="textCapSentences"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTieuDe"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- NHập mô tả công việc -->
    <EditText
        android:id="@+id/edtMoTaCV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Nhập mô tả chi tiết công việc"
        android:inputType="textMultiLine"
        android:lines="3"
        android:gravity="top|start"
        app:layout_constraintTop_toBottomOf="@id/edtTenCV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nút tạo công việc -->
    <Button
        android:id="@+id/btnTaoCV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Tạo công việc"
        app:layout_constraintTop_toBottomOf="@id/edtMoTaCV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nút xem danh sách công việc -->
    <Button
        android:id="@+id/btnXemDS"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Xem danh sách công việc"
        app:layout_constraintTop_toBottomOf="@id/btnTaoCV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>